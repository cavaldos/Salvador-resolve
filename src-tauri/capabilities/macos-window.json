  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "macos-window",
  "description": "Make the Cutnora app headers draggable on macOS",
  "platforms": ["macOS"],
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
