{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salvador Resolve",
  "version": "0.1.0",
  "identifier": "com.salvadorresolve.app",
  "build": {
    "beforeDevCommand": "npm run ensure:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ensure:sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1300,
        "height": 720,
        "minWidth": 1300,
        "minHeight": 720,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "devtools": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**/*",
            "$DESKTOP/**/*",
            "$DOCUMENT/**/*",
            "$DOWNLOAD/**/*",
            "$VIDEO/**/*",
            "$PUBLIC/**/*",
            "$APPDATA/**/*",
            "$RESOURCE/**/*",
            "/Volumes/**/*",
            "$APPCACHE/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AIEraDev",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
